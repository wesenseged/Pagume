  <id>io.github.wesenseged.Pagume</id>
  <name>Pagume</name>
  <summary>Ethiopian calendar</summary>

  <description>
  <p>Pagume is an offline Ethiopian calendar.</p>
  <p>Features</p>
	  <ul>
      <li>Ethiopian Calendar</li>
      <li>Public Holidays</li>
      <li>Ethiopian to Gregorian Converter</li>
      <li>Gregorian to Ethiopian Converter</li>
      <li>Fasting Days</li>
      <li>Geez &amp; Arabic Numerals</li>
	  </ul>
  </description>


